# Postgres connection string (from Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Any long random string - used to sign admin login sessions
JWT_SECRET=change-this-to-a-long-random-string

# One-time setup key - used once to create your first admin account, then you can forget it
SETUP_KEY=change-this-to-something-only-you-know
